generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Fighter {
  id        Int      @id @default(autoincrement())
  name      String
  age       Int
  height    Int
  weight    Int
  wins      Int      @default(0)
  losses    Int      @default(0)
  draws     Int      @default(0)
  photo     String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}